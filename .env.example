# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Pathways Assistance Center — Optional Frontend Integration Environment Variables
# Paste your Stripe Payment Link (e.g. https://buy.stripe.com/...) to bind all Donate buttons
VITE_STRIPE_PAYMENT_LINK=""

# Optional Supabase Configuration for persistent backend storage
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Formspree or Resend Webhook Endpoint for info@pathwaysac.org notifications
VITE_FORM_ENDPOINT=""
